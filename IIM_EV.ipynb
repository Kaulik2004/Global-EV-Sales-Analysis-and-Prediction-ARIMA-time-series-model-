        "df_countries = df[~df['region'].isin(['World', 'Europe', 'EU27', 'Rest of the world'])]\n",
        "df_countries = df_countries.groupby(['region', 'year'])['value'].sum().reset_index()\n",
        "\n",
        "# Plot 2: Global Total vs yr\n",
